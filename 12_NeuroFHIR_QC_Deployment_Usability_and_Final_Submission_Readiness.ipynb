        "\n",
        "screenshot_directory = Path(SCREENSHOT_DIRECTORY)\n",
        "screenshot_directory.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "available_screenshots = [\n",
        "    path\n",
        "    for path in screenshot_directory.rglob(\"*\")\n",
        "    if path.is_file()\n",
        "    and path.suffix.lower()\n",
        "    in {\".png\", \".jpg\", \".jpeg\", \".webp\"}\n",
        "]\n",
        "\n",
        "screenshot_rows = []\n",
        "for identifier, description in required_screenshots:\n",
        "    matches = [\n",
        "        path\n",
        "        for path in available_screenshots\n",
        "        if path.name.lower().startswith(identifier.lower())\n",
        "        or identifier.lower() in path.stem.lower()\n",
        "    ]\n",
        "    selected = matches[0] if matches else None\n",
        "    screenshot_rows.append(\n",
        "        {\n",
        "            \"id\": identifier,\n",
        "            \"description\": description,\n",
        "            \"captured\": selected is not None,\n",
        "            \"path\": str(selected) if selected else None,\n",
        "            \"size_bytes\": (\n",
        "                selected.stat().st_size\n",
        "                if selected\n",
        "                else None\n",
        "            ),\n",
        "            \"sha256\": (\n",
        "                sha256_file(selected)\n",
        "                if selected\n",
        "                else None\n",
        "            ),\n",
        "        }\n",
        "    )\n",
        "\n",
        "screenshot_capture_rate = round(\n",
        "    sum(row[\"captured\"] for row in screenshot_rows)\n",
        "    / len(screenshot_rows),\n",
        "    6,\n",
        ")\n",
        "screenshots_complete = screenshot_capture_rate == 1.0\n",
        "\n",
        "video_configured = bool(DEMO_VIDEO_URL.strip())\n",
        "video_check = None\n",
        "video_reviewer_accessible = False\n",
        "if video_configured:\n",
        "    video_result = fetch_url(\n",
        "        DEMO_VIDEO_URL.strip(),\n",
        "        timeout_seconds=30,\n",
        "        max_bytes=250_000,\n",
        "    )\n",
        "    video_check = {\n",
        "        key: value\n",
        "        for key, value in video_result.items()\n",
        "        if key != \"content\"\n",
        "    }\n",
        "    video_reviewer_accessible = bool(video_result[\"ok\"])\n",
        "\n",
        "branding_files = {\n",
        "    \"logo\": Path(LOGO_PATH),\n",
        "    \"headshot\": Path(HEADSHOT_PATH),\n",
        "    \"promotional_image\": Path(PROMOTIONAL_IMAGE_PATH),\n",
        "}\n",
        "branding_status = {\n",
        "    name: nonempty_file(path)\n",
        "    for name, path in branding_files.items()\n",
