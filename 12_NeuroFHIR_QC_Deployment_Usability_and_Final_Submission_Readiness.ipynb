      "source": [
        "# Cell 2 — Verify the local production build and public deployment\n",
        "\n",
        "local_build_files = sorted(\n",
        "    path\n",
        "    for path in LOCAL_BUILD_ROOT.rglob(\"*\")\n",
        "    if path.is_file()\n",
        ")\n",
        "local_asset_files = [\n",
        "    path\n",
        "    for path in local_build_files\n",
        "    if path.suffix.lower()\n",
        "    in {\n",
        "        \".js\",\n",
        "        \".css\",\n",
        "        \".json\",\n",
        "        \".png\",\n",
        "        \".jpg\",\n",
        "        \".jpeg\",\n",
        "        \".svg\",\n",
        "        \".webp\",\n",
        "    }\n",
        "]\n",
        "\n",
        "local_build_status = {\n",
        "    \"index_html_exists\": LOCAL_INDEX_PATH.exists(),\n",
        "    \"app_data_exists\": LOCAL_APP_DATA_PATH.exists(),\n",
        "    \"local_file_count\": len(local_build_files),\n",
        "    \"local_asset_count\": len(local_asset_files),\n",
        "    \"case_count\": len(local_app_data.get(\"cases\", [])),\n",
        "    \"screen_count\": int(screen_matrix.get(\"screen_count\", 0)),\n",
        "    \"screen_implementation_rate\": screen_matrix.get(\n",
        "        \"implementation_rate\"\n",
        "    ),\n",
        "}\n",
        "\n",
        "if not all(\n",
        "    [\n",
        "        local_build_status[\"index_html_exists\"],\n",
        "        local_build_status[\"app_data_exists\"],\n",
        "        local_build_status[\"case_count\"] == 3,\n",
        "        local_build_status[\"screen_count\"] == 6,\n",
        "        local_build_status[\"screen_implementation_rate\"] == 1.0,\n",
        "    ]\n",
        "):\n",
        "    raise AssertionError(\n",
        "        \"The local reviewer production build failed its readiness gate.\"\n",
        "    )\n",
        "\n",
        "public_checks: list[dict[str, Any]] = []\n",
        "public_app_configured = bool(PUBLIC_APP_URL.strip())\n",
        "public_app_reachable = False\n",
        "public_data_valid = False\n",
        "public_assets_pass_rate = None\n",
        "public_case_count = None\n",
        "\n",
        "if public_app_configured:\n",
        "    base_url = normalized_url(PUBLIC_APP_URL)\n",
        "    index_check = fetch_url(base_url)\n",
        "    public_checks.append(\n",
        "        {\n",
        "            key: value\n",
        "            for key, value in index_check.items()\n",
        "            if key != \"content\"\n",
        "        }\n",
        "    )\n",
        "\n",
        "    app_data_url = urljoin(base_url, \"data/app_data.json\")\n",
        "    data_check = fetch_url(app_data_url)\n",
        "    public_checks.append(\n",
        "        {\n",
        "            key: value\n",
        "            for key, value in data_check.items()\n",
        "            if key != \"content\"\n",
        "        }\n",
        "    )\n",
        "\n",
        "    public_app_reachable = bool(index_check[\"ok\"])\n",
        "\n",
        "    if data_check[\"ok\"]:\n",
        "        try:\n",
        "            public_data = json.loads(\n",
        "                data_check[\"content\"].decode(\"utf-8\")\n",
        "            )\n",
        "            public_case_count = len(\n",
        "                public_data.get(\"cases\", [])\n",
        "            )\n",
        "            public_data_valid = (\n",
        "                public_case_count == 3\n",
        "                and len(\n",
        "                    public_data.get(\n",
        "                        \"representative_fhir_resources\",\n",
        "                        {},\n",
        "                    )\n",
        "                )\n",
        "                >= 13\n",
        "            )\n",
        "\n",
        "            public_asset_urls = []\n",
        "            for case in public_data.get(\"cases\", []):\n",
        "                for image_path in case.get(\"images\", []):\n",
        "                    public_asset_urls.append(\n",
        "                        urllib.parse.urljoin(\n",
        "                            base_url,\n",
        "                            str(image_path).lstrip(\"./\"),\n",
        "                        )\n",
        "                    )\n",
        "\n",
        "            index_html = index_check[\"content\"].decode(\n",
        "                \"utf-8\",\n",
        "                errors=\"ignore\",\n",
        "            )\n",
        "            relative_assets = re.findall(\n",
        "                r\"(?:src|href)=[\\\"']([^\\\"']+\\.(?:js|css))[\\\"']\",\n",
        "                index_html,\n",
        "                flags=re.IGNORECASE,\n",
        "            )\n",
        "            for asset in relative_assets:\n",
        "                public_asset_urls.append(\n",
        "                    urllib.parse.urljoin(base_url, asset)\n",
        "                )\n",
        "\n",
        "            asset_results = []\n",
        "            for asset_url in sorted(set(public_asset_urls)):\n",
        "                result = fetch_url(\n",
