        "# Cell 4 — Audit screenshots, video, and branding\n",
        "\n",
        "required_screenshots = [\n",
        "    (\"S01\", \"Launch screen and data boundary\"),\n",
        "    (\"S02\", \"Patient timeline and imaging context\"),\n",
        "    (\"S03\", \"Stable MRI/QC result\"),\n",
