        "FINAL_ZIP_PATH = (\n",
        "    FINAL_RELEASE_ROOT\n",
        "    / \"NeuroFHIR_QC_AMIA_2026_Final_Candidate.zip\"\n",
        ")\n",
        "AUDIT_JSON_PATH = (\n",
        "    PROJECT_ROOT\n",
        "    / \"evaluation/results/\"\n",
        "      \"notebook_12_deployment_usability_final_readiness_audit.json\"\n",
        ")\n",
        "AUDIT_MD_PATH = (\n",
        "    DOC_ROOT\n",
        "    / \"NOTEBOOK_12_DEPLOYMENT_USABILITY_FINAL_READINESS.md\"\n",
        ")\n",
        "\n",
        "for folder in (\n",
        "    USABILITY_ROOT,\n",
        "    OUTPUT_ROOT,\n",
        "    PLOT_ROOT,\n",
        "    TABLE_ROOT,\n",
        "    FINAL_RELEASE_ROOT,\n",
        "    FINAL_PACKAGE_ROOT,\n",
        "    DOC_ROOT,\n",
        "):\n",
        "    folder.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "\n",
        "def load_json(path: Path) -> Any:\n",
        "    with path.open(\"r\", encoding=\"utf-8\") as handle:\n",
        "        return json.load(handle)\n",
        "\n",
        "\n",
        "def write_json(path: Path, payload: Any) -> None:\n",
        "    path.parent.mkdir(parents=True, exist_ok=True)\n",
        "    temporary = path.with_suffix(path.suffix + \".tmp\")\n",
        "    with temporary.open(\"w\", encoding=\"utf-8\") as handle:\n",
        "        json.dump(\n",
        "            payload,\n",
        "            handle,\n",
        "            indent=2,\n",
        "            ensure_ascii=False,\n",
        "            allow_nan=False,\n",
        "        )\n",
        "        handle.write(\"\\n\")\n",
        "    temporary.replace(path)\n",
        "\n",
        "\n",
        "def utc_now() -> str:\n",
        "    return (\n",
        "        datetime.now(timezone.utc)\n",
        "        .replace(microsecond=0)\n",
        "        .isoformat()\n",
        "        .replace(\"+00:00\", \"Z\")\n",
        "    )\n",
        "\n",
        "\n",
        "def sha256_file(path: Path) -> str:\n",
        "    digest = hashlib.sha256()\n",
        "    with path.open(\"rb\") as handle:\n",
        "        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n",
        "            digest.update(chunk)\n",
        "    return digest.hexdigest()\n",
        "\n",
        "\n",
        "def nonempty_file(path_value: str | Path) -> bool:\n",
        "    if not str(path_value).strip():\n",
        "        return False\n",
        "    path = Path(path_value)\n",
        "    return path.exists() and path.is_file() and path.stat().st_size > 0\n",
        "\n",
        "\n",
        "def normalized_url(url: str) -> str:\n",
        "    value = url.strip()\n",
        "    if not value:\n",
        "        return \"\"\n",
        "    return value if value.endswith(\"/\") else value + \"/\"\n",
        "\n",
        "\n",
        "def urljoin(base: str, relative: str) -> str:\n",
        "    return urllib.parse.urljoin(normalized_url(base), relative)\n",
        "\n",
        "\n",
        "def fetch_url(\n",
        "    url: str,\n",
        "    *,\n",
        "    timeout_seconds: int = 30,\n",
        "    max_bytes: int = 5_000_000,\n",
        ") -> dict[str, Any]:\n",
        "    request = urllib.request.Request(\n",
        "        url,\n",
        "        headers={\n",
        "            \"User-Agent\": \"NeuroFHIR-QC-Readiness-Audit/1.0\",\n",
        "            \"Accept\": \"*/*\",\n",
        "        },\n",
        "    )\n",
        "    started = time.perf_counter()\n",
        "    try:\n",
        "        with urllib.request.urlopen(\n",
        "            request,\n",
        "            timeout=timeout_seconds,\n",
        "        ) as response:\n",
        "            content = response.read(max_bytes)\n",
        "            elapsed = time.perf_counter() - started\n",
        "            return {\n",
        "                \"url\": url,\n",
        "                \"ok\": 200 <= int(response.status) < 400,\n",
        "                \"status_code\": int(response.status),\n",
        "                \"content_type\": response.headers.get(\n",
        "                    \"Content-Type\",\n",
        "                    \"\",\n",
        "                ),\n",
        "                \"bytes_read\": len(content),\n",
        "                \"elapsed_seconds\": round(elapsed, 3),\n",
        "                \"content\": content,\n",
        "                \"error\": None,\n",
        "            }\n",
        "    except Exception as exc:\n",
        "        elapsed = time.perf_counter() - started\n",
        "        return {\n",
        "            \"url\": url,\n",
        "            \"ok\": False,\n",
        "            \"status_code\": None,\n",
        "            \"content_type\": \"\",\n",
        "            \"bytes_read\": 0,\n",
        "            \"elapsed_seconds\": round(elapsed, 3),\n",
        "            \"content\": b\"\",\n",
        "            \"error\": f\"{type(exc).__name__}: {exc}\",\n",
        "        }\n",
        "\n",
        "\n",
        "def truthy(value: Any) -> bool:\n",
        "    return str(value).strip().lower() in {\n",
        "        \"true\",\n",
        "        \"1\",\n",
        "        \"yes\",\n",
        "        \"y\",\n",
        "        \"completed\",\n",
        "        \"complete\",\n",
        "    }\n",
        "\n",
        "\n",
        "required_paths = [\n",
        "    PROJECT_CONFIG_PATH,\n",
        "    NOTEBOOK_MANIFEST_PATH,\n",
        "    NB11_AUDIT_PATH,\n",
        "    NB11_SCREEN_MATRIX_PATH,\n",
        "    LOCAL_INDEX_PATH,\n",
        "    LOCAL_APP_DATA_PATH,\n",
        "]\n",
        "missing = [\n",
        "    str(path)\n",
        "    for path in required_paths\n",
        "    if not path.exists() or path.stat().st_size == 0\n",
        "]\n",
        "if missing:\n",
        "    raise FileNotFoundError(\n",
        "        \"Notebook 12 prerequisites are missing:\\n\"\n",
        "        + \"\\n\".join(f\" - {path}\" for path in missing)\n",
        "    )\n",
        "\n",
        "project_config = load_json(PROJECT_CONFIG_PATH)\n",
        "notebook_manifest = load_json(NOTEBOOK_MANIFEST_PATH)\n",
        "nb11_audit = load_json(NB11_AUDIT_PATH)\n",
        "screen_matrix = load_json(NB11_SCREEN_MATRIX_PATH)\n",
        "local_app_data = load_json(LOCAL_APP_DATA_PATH)\n",
        "\n",
