        "    raise RuntimeError(\"Notebook 11 audit is not completed.\")\n",
        "\n",
        "if screen_matrix.get(\"implementation_rate\") != 1.0:\n",
        "    raise AssertionError(\"Notebook 11 did not implement all six screens.\")\n",
        "\n",
        "if len(local_app_data.get(\"cases\", [])) != 3:\n",
        "    raise AssertionError(\"The reviewer build does not contain three cases.\")\n",
        "\n",
        "OFFICIAL_RULES_URL = (\n",
        "    \"https://amia.org/education-events/\"\n",
        "    \"amia-2026-annual-symposium/fhir\"\n",
        ")\n",
        "OFFICIAL_DEADLINE = \"2026-09-10 23:59 ET\"\n",
        "\n",
        "print(\"=\" * 112)\n",
        "print(\"✅ Notebook 11 completion gate passed\")\n",
        "print(\"✅ Local reviewer production build found\")\n",
        "print(\"✅ Three cases and six screens found\")\n",
        "print(f\"📅 Official deadline: {OFFICIAL_DEADLINE}\")\n",
        "print(f\"🌐 Public app URL configured: {bool(PUBLIC_APP_URL.strip())}\")\n",
        "print(f\"🎥 Video URL configured: {bool(DEMO_VIDEO_URL.strip())}\")\n",
        "print(f\"📋 Submission category: {SUBMISSION_CATEGORY}\")\n",
        "print(\"=\" * 112)"
      ]
    },
